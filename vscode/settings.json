  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.mergeEditor": false,
  "git.pullBeforeCheckout": true,
  "git.rebaseWhenSync": true,
