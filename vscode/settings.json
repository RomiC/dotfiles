  "gitlens.views.repositories.files.layout": "list",
  // - Liveshare
  "liveshare.autoShareTerminals": true,
  "liveshare.showInStatusBar": "whileCollaborating",
  // - Prettier (default settings)
  "prettier.requireConfig": false,
  //   - Formatting
  "prettier.arrowParens": "always",
  "prettier.endOfLine": "lf",
  "prettier.jsxSingleQuote": true,
  "prettier.jsxBracketSameLine": true,
  "prettier.singleQuote": true,
  // - TabNine
  "tabnine.experimentalAutoImports": true,
  // - Vim
  "vim.autoSwitchInputMethod.enable": true,
  "vim.autoSwitchInputMethod.defaultIM": "com.apple.keylayout.ABC",
  "vim.autoSwitchInputMethod.obtainIMCmd": "/Users/roman.charugin/.local/bin/im-select",
  "vim.autoSwitchInputMethod.switchIMCmd": "/Users/roman.charugin/.local/bin/im-select {im}",
  "vim.cursorStylePerMode.visual": "block-outline",
  "vim.easymotion": true,
  "vim.enableNeovim": true,
  "vim.foldfix": true,
  "vim.highlightedyank.enable": true,
  "vim.startofline": false,
  "vim.textwidth": 120,
  "vim.visualstar": true,
  "vim.useSystemClipboard": true,
  //   - Keybindings
  "vim.normalModeKeyBindingsNonRecursive": [
    // - Find in files
    {
      "before": ["g", "f"],
      "after": ["v", "i", "w"],
      "commands": ["workbench.action.findInFiles"],
    },
    // - Formatting current line
    {
      "before": ["=", "="],
      "after": ["V"],
      "commands": ["editor.action.formatSelection"],
    },
    // - Change indent using tab
    {
      "before": ["<tab>"],
      "commands": ["editor.action.indentLines"],
    },
    {
      "before": ["<S-tab>"],
      "commands": ["editor.action.outdentLines"],
    },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    // - Find in files (selection)
    {
      "before": ["g", "f"],
      "commands": ["workbench.action.findInFiles"],
    },
    // - Formatting current line
    {
      "before": ["=", "="],
      "commands": ["editor.action.formatSelection"],
    },
    // - Change indent using tab
    {
      "before": ["<tab>"],
      "commands": ["editor.action.indentLines"],
    },
    {
      "before": ["<S-tab>"],
      "commands": ["editor.action.outdentLines"],
    },
  ],
